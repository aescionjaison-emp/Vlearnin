{
  "hosting": {
    "public": "apps/web/out",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/verify-certificate/**",
        "destination": "/verify-certificate/index.html"
      }
    ]
  }
}
