{
  "name": "vlearnin-v2",
  "version": "2.0.0",
  "private": true,
  "description": "VLEARNIN Academy — Full-Stack Educational Platform",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @vlearnin/web dev",
    "dev:api": "pnpm --filter @vlearnin/api dev",
    "build": "pnpm --filter @vlearnin/shared build && pnpm --filter @vlearnin/api build && pnpm --filter @vlearnin/web build",
    "test": "pnpm --filter @vlearnin/api test && pnpm --filter @vlearnin/web test",
    "db:generate": "pnpm --filter @vlearnin/api db:generate",
    "db:migrate": "pnpm --filter @vlearnin/api db:migrate",
    "db:seed": "pnpm --filter @vlearnin/api db:seed",
    "generate:about-assets": ".\\.venv-image\\Scripts\\python.exe scripts/image-processing/generate-about-assets.py"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
