# ==========================================
# VLEARNIN v2 — Environment Configuration
# Copy to .env (and apps/api/.env, apps/web/.env.local)
# ==========================================

# Database (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/vlearnin_v2?schema=public"

# API Server
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Authentication & Security
JWT_SECRET="replace-with-64-char-cryptographically-random-secret-key"
COOKIE_SECRET="replace-with-64-char-cookie-signing-secret"
ADMIN_SEED_EMAIL="admin@vlearnin.com"
ADMIN_SEED_PASSWORD="ChangeMeImmediately!2026"
PUBLIC_BASE_URL="http://localhost:3000"

# Email / SMTP / Resend (Optional — degrades gracefully when unconfigured)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="VLEARNIN Academy <info@vlearnin.com>"
ADMIN_NOTIFICATION_EMAIL="info@vlearnin.com"

# S3-Compatible Media Storage (Optional — falls back to local secure storage)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ap-south-1"

# Frontend Public Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="917022337580"
